# Copy this file to a new file named .env  (the .env file is never uploaded to Git)
# and put your own values in it.

# A long random string. Create one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=paste-your-generated-key-here

# True while developing on your own computer. Use False on a live website.
DJANGO_DEBUG=True

# Only needed when DJANGO_DEBUG=False. Example: yourname.pythonanywhere.com,www.example.com
DJANGO_ALLOWED_HOSTS=